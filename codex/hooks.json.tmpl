{
  "description": "ai-coding-harness v3 · 运行时硬闸门 + 规范注入 + log/plan 维护",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"__HARNESS_HOOKS_DIR__/session_start.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"__HARNESS_HOOKS_DIR__/user_prompt_submit.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "apply_patch|Edit|Write|MultiEdit|NotebookEdit|exec_command|shell|local_shell|Bash|unified_exec|run_command|terminal|execute",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"__HARNESS_HOOKS_DIR__/pre_tool_use.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write|MultiEdit|NotebookEdit|exec_command|shell|local_shell|Bash|unified_exec|run_command|terminal|execute",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"__HARNESS_HOOKS_DIR__/post_tool_use.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"__HARNESS_HOOKS_DIR__/stop.py\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
